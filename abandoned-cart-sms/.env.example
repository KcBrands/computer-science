# Nom de ton magasin (apparaît dans le SMS)
STORE_NAME=Mon Magasin

# URL de ton magasin (pour le lien dans le SMS)
STORE_URL=https://mon-magasin.myshopify.com

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
