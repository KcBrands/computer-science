# ─── Shopify ──────────────────────────────────────────────────────────────────
# Ton secret webhook (Settings → Notifications → Webhooks dans Shopify Admin)
SHOPIFY_WEBHOOK_SECRET=ton_webhook_secret_ici

# ─── AWS SNS ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
